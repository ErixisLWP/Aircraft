<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/network_mode_label"
        android:textSize="16sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/networkModeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/networkModePve"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/network_mode_pve" />

        <RadioButton
            android:id="@+id/networkModePvp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/network_mode_pvp" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/network_role_label"
        android:textSize="16sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/networkRoleGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/networkRoleHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/network_role_host" />

        <RadioButton
            android:id="@+id/networkRoleClient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/network_role_client" />
    </RadioGroup>

    <CheckBox
        android:id="@+id/networkEmulatorModeCheckBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/network_emulator_mode_label" />

    <TextView
        android:id="@+id/networkEmulatorTipText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/network_emulator_mode_desc"
        android:textColor="#666666"
        android:textSize="13sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/networkHostInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/network_host_hint"
        android:inputType="textUri"
        android:maxLines="1" />

    <EditText
        android:id="@+id/networkPortInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/network_port_hint"
        android:inputType="number"
        android:maxLines="1"
        android:text="24567" />

</LinearLayout>
